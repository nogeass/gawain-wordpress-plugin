#. Plugin Name of the plugin
msgid "Gawain AI Video"
msgstr "Gawain AI Video"

#: includes/class-gawain-admin.php
msgid "WooCommerce is required but not active. Please install and activate WooCommerce."
msgstr "WooCommerce가 필요하지만 활성화되어 있지 않습니다. WooCommerce를 설치하고 활성화해 주세요."

#: includes/class-gawain-admin.php
msgid "You do not have permission to access this page."
msgstr "이 페이지에 접근할 권한이 없습니다."

#: includes/class-gawain-admin.php
msgid "Generate AI promotional videos for your WooCommerce products."
msgstr "WooCommerce 상품의 AI 프로모션 동영상을 생성합니다."

#: includes/class-gawain-admin.php
msgid "Videos"
msgstr "동영상"

#: includes/class-gawain-admin.php
msgid "Settings"
msgstr "설정"

#: includes/class-gawain-admin.php
msgid "External Service"
msgstr "외부 서비스"

#. translators: %s: service domain
#: includes/class-gawain-admin.php
msgid "This plugin sends product data to %s for AI video generation. No data is sent until you enable the toggle below and explicitly click \"Generate\"."
msgstr "이 플러그인은 AI 동영상 생성을 위해 상품 데이터를 %s 으로 전송합니다. 아래 토글을 활성화하고 \"생성\"을 클릭하기 전까지 데이터가 전송되지 않습니다."

#: includes/class-gawain-admin.php
msgid "Enable external processing"
msgstr "외부 처리 활성화"

#: includes/class-gawain-admin.php
msgid "I consent to sending product data to gawain.nogeass.com for video generation"
msgstr "동영상 생성을 위해 gawain.nogeass.com으로 상품 데이터를 전송하는 것에 동의합니다"

#: includes/class-gawain-admin.php
msgid "When OFF, no data is sent to any external server. Default: OFF."
msgstr "OFF일 때 외부 서버로 데이터가 전송되지 않습니다. 기본값: OFF."

#: includes/class-gawain-admin.php
msgid "API Key"
msgstr "API 키"

#. translators: %s: link to service
#: includes/class-gawain-admin.php
msgid "Get your API key at %s. Optional — free preview (watermarked) works without a key."
msgstr "API 키는 %s 에서 받을 수 있습니다. 선택 사항 — 키 없이도 무료 미리보기(워터마크 포함)를 사용할 수 있습니다."

#: includes/class-gawain-admin.php
msgid "API URL"
msgstr "API URL"

#: includes/class-gawain-admin.php
msgid "Default value is correct for most users."
msgstr "대부분의 사용자에게 기본값이 적합합니다."

#: includes/class-gawain-admin.php
msgid "Data Management"
msgstr "데이터 관리"

#: includes/class-gawain-admin.php
msgid "Delete data on uninstall"
msgstr "제거 시 데이터 삭제"

#: includes/class-gawain-admin.php
msgid "Remove all plugin settings and the video tracking table when the plugin is deleted"
msgstr "플러그인 삭제 시 모든 설정과 동영상 관리 테이블을 삭제합니다"

#: includes/class-gawain-admin.php
msgid "Save Settings"
msgstr "설정 저장"

#: includes/class-gawain-admin.php
msgid "WooCommerce is required. Please install and activate WooCommerce."
msgstr "WooCommerce가 필요합니다. WooCommerce를 설치하고 활성화해 주세요."

#. translators: %s: link to settings
#: includes/class-gawain-admin.php
msgid "External processing is disabled. Enable it in %s to generate videos."
msgstr "외부 처리가 비활성화되어 있습니다. 동영상을 생성하려면 %s 에서 활성화해 주세요."

#: includes/class-gawain-admin.php
msgid "Products"
msgstr "상품"

#: includes/class-gawain-admin.php
msgid "Generated Videos"
msgstr "생성된 동영상"

#: includes/class-gawain-api.php
msgid "External processing is not enabled. Please enable it in settings."
msgstr "외부 처리가 활성화되어 있지 않습니다. 설정에서 활성화해 주세요."

#: includes/class-gawain-api.php
#: includes/class-gawain-rest.php
msgid "External processing is not enabled."
msgstr "외부 처리가 활성화되어 있지 않습니다."

#: includes/class-gawain-rest.php
msgid "Product not found."
msgstr "상품을 찾을 수 없습니다."

#: includes/class-gawain-rest.php
msgid "Product has no image."
msgstr "상품에 이미지가 없습니다."

#: includes/class-gawain-rest.php
msgid "Unexpected API response."
msgstr "예상치 못한 API 응답입니다."

#: includes/class-gawain-rest.php
msgid "Video not found or not ready."
msgstr "동영상을 찾을 수 없거나 아직 준비되지 않았습니다."

#: assets/js/admin.js
msgid "No products found"
msgstr "상품을 찾을 수 없습니다"

#: assets/js/admin.js
msgid "Please add products in WooCommerce."
msgstr "WooCommerce에서 상품을 추가해 주세요."

#: assets/js/admin.js
msgid "Generating"
msgstr "생성 중"

#. translators: %d: number of videos
#: assets/js/admin.js
msgid "%d videos"
msgstr "%d개"

#: assets/js/admin.js
msgid "No image"
msgstr "이미지 없음"

#: assets/js/admin.js
msgid "Starting..."
msgstr "시작 중..."

#: assets/js/admin.js
msgid "Regenerate Video"
msgstr "동영상 재생성"

#: assets/js/admin.js
msgid "Generate Video"
msgstr "동영상 생성"

#: assets/js/admin.js
msgid "Generation failed"
msgstr "생성에 실패했습니다"

#: assets/js/admin.js
msgid "Generating 3D"
msgstr "3D 생성 중"

#: assets/js/admin.js
msgid "Creating video"
msgstr "동영상 제작 중"

#: assets/js/admin.js
msgid "Finalizing"
msgstr "마무리 중"

#: assets/js/admin.js
msgid "Queued..."
msgstr "대기 중..."

#: assets/js/admin.js
msgid "Cancel"
msgstr "취소"

#: assets/js/admin.js
msgid "Placed"
msgstr "배치됨"

#: assets/js/admin.js
msgid "Remove from site"
msgstr "사이트에서 제거"

#: assets/js/admin.js
msgid "Place on site"
msgstr "사이트에 배치"

#: assets/js/admin.js
msgid "Delete"
msgstr "삭제"

#: assets/js/admin.js
msgid "Retry"
msgstr "재시도"

#: assets/js/admin.js
msgid "External processing is not enabled. Please enable it in the Settings tab."
msgstr "외부 처리가 활성화되어 있지 않습니다. 설정 탭에서 활성화해 주세요."

#. translators: %s: product title
#: assets/js/admin.js
msgid "Started generating video for \"%s\""
msgstr "\"%s\" 동영상 생성을 시작했습니다"

#: assets/js/admin.js
msgid "Failed to start video generation"
msgstr "동영상 생성 시작에 실패했습니다"

#: assets/js/admin.js
msgid "Placed on site"
msgstr "사이트에 배치했습니다"

#: assets/js/admin.js
msgid "Failed to place on site"
msgstr "배치에 실패했습니다"

#: assets/js/admin.js
msgid "Removed from site"
msgstr "사이트에서 제거했습니다"

#: assets/js/admin.js
msgid "Failed to remove from site"
msgstr "제거에 실패했습니다"

#: assets/js/admin.js
msgid "Deleted"
msgstr "삭제했습니다"

#: assets/js/admin.js
msgid "Failed to delete"
msgstr "삭제에 실패했습니다"

#: assets/js/admin.js
msgid "Video generation complete"
msgstr "동영상 생성이 완료되었습니다"

#: includes/class-gawain-storefront.php
msgid "Promotional Video"
msgstr "프로모션 동영상"

#: includes/class-gawain-storefront.php
msgid "Toggle mute"
msgstr "음소거 전환"

#: includes/class-gawain-storefront.php
msgid "Fullscreen"
msgstr "전체 화면"
